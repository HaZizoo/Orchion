# Orchion API — copy this file to server/.env and fill it in.
# This file is read by the Node server only; nothing here reaches the browser.

# Groq key (https://console.groq.com/keys). Required for streamed answers;
# tool execution still works without it.
GROQ_API_KEY=

# MongoDB (local Docker container or an Atlas connection string).
MONGODB_URI=mongodb://127.0.0.1:27017/orchion

# HMAC secret for bearer tokens. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# If omitted, an ephemeral key is used and every token dies on restart.
AUTH_SECRET=

PORT=8787
# GROQ_MODEL=openai/gpt-oss-120b
